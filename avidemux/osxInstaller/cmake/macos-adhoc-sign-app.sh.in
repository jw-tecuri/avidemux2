#!/bin/bash
# Turn the finished .app into a codesign-strict bundle.
# Called from admFixupBundle.cmake after install_name_tool rewrites.
# /bin/bash on macOS is 3.2, so this script avoids mapfile and other bash 4 syntax.
set -eu

APP="@BUNDLE@"

fail()
{
    echo "** $1 **" >&2
    exit 1
}

if [ ! -d "${APP}/Contents" ]; then
    fail "directory \"${APP}/Contents\" does not exist"
fi

echo "Repairing framework layout and modes in ${APP}"

# Homebrew bottles and fixup_bundle leave files mode 0444. Owner write is
# required before we replace symlinks, and so later tools (xattr) succeed.
find "${APP}" -type d -exec chmod u+w {} +
find "${APP}" -type f -exec chmod u+w {} +

repair_framework()
{
    fw="$1"
    name=$(basename "${fw}" .framework)
    versions="${fw}/Versions"
    mkdir -p "${versions}"

    ver=""
    if [ -d "${versions}/A" ]; then
        ver="A"
    else
        for d in "${versions}"/*; do
            [ -e "${d}" ] || [ -L "${d}" ] || continue
            base=$(basename "${d}")
            if [ "${base}" = "Current" ]; then
                continue
            fi
            ver="${base}"
            break
        done
    fi
    if [ -z "${ver}" ]; then
        ver="A"
        mkdir -p "${versions}/A"
    fi

    # Keep the versioned copy when the top level is a real file, not a symlink.
    for item in "${fw}"/*; do
        [ -e "${item}" ] || [ -L "${item}" ] || continue
        base=$(basename "${item}")
        if [ "${base}" = "Versions" ]; then
            continue
        fi
        if [ -L "${item}" ]; then
            continue
        fi
        if [ ! -e "${versions}/${ver}/${base}" ]; then
            mv "${item}" "${versions}/${ver}/${base}"
        fi
    done

    # codesign --strict looks for Resources/Info.plist via Versions/Current.
    if [ ! -f "${versions}/${ver}/Resources/Info.plist" ]; then
        mkdir -p "${versions}/${ver}/Resources"
        cat > "${versions}/${ver}/Resources/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>${name}</string>
  <key>CFBundleIdentifier</key>
  <string>org.qt-project.Qt.${name}</string>
  <key>CFBundleName</key>
  <string>${name}</string>
  <key>CFBundlePackageType</key>
  <string>FMWK</string>
  <key>CFBundleVersion</key>
  <string>1.0</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
</dict>
</plist>
PLIST
    fi

    rm -rf "${versions}/Current"
    ln -s "${ver}" "${versions}/Current"

    for item in "${versions}/${ver}"/*; do
        [ -e "${item}" ] || [ -L "${item}" ] || continue
        base=$(basename "${item}")
        if [ -e "${fw}/${base}" ] || [ -L "${fw}/${base}" ]; then
            rm -rf "${fw}/${base}"
        fi
        ln -s "Versions/Current/${base}" "${fw}/${base}"
    done

    if [ ! -e "${fw}/${name}" ]; then
        fail "framework ${fw} has no ${name} binary after layout repair"
    fi
}

for fw in "${APP}/Contents/Frameworks/"*.framework; do
    if [ -d "${fw}" ]; then
        repair_framework "${fw}"
    fi
done

# Directories and Mach-O binaries are 0755. Other files are 0644.
find "${APP}" -type d -exec chmod 0755 {} +
find "${APP}" -type f -exec chmod 0644 {} +
find "${APP}" -type f -print0 | while IFS= read -r -d '' f; do
    if file -b "${f}" | grep -q 'Mach-O'; then
        chmod 0755 "${f}"
    fi
done

dangling=$(find "${APP}" -type l ! -exec test -e {} \; -print || true)
if [ -n "${dangling}" ]; then
    echo "Dangling symlinks:" >&2
    printf '%s\n' "${dangling}" >&2
    fail "framework layout left dangling symlinks"
fi

echo "Ad-hoc signing ${APP} inside-out"
python3 - "${APP}" <<'PY'
import os
import subprocess
import sys

app = sys.argv[1]
main_dir = os.path.join(app, "Contents", "MacOS")


def is_macho(path):
    if os.path.islink(path) or not os.path.isfile(path):
        return False
    try:
        kind = subprocess.check_output(["file", "-b", path], text=True)
    except (OSError, subprocess.CalledProcessError):
        return False
    return "Mach-O" in kind


def is_framework_main_binary(path):
    parts = path.split(os.sep)
    if "Versions" not in parts:
        return False
    idx = parts.index("Versions")
    if idx < 1 or not parts[idx - 1].endswith(".framework"):
        return False
    fwname = parts[idx - 1][: -len(".framework")]
    return os.path.basename(path) == fwname and idx == len(parts) - 2


def sign(path):
    print("  codesign %s" % path, flush=True)
    subprocess.check_call(
        ["/usr/bin/codesign", "--force", "--sign", "-", "--timestamp=none", path]
    )


machos = []
frameworks = []
for root, dirs, files in os.walk(app):
    for name in dirs:
        if name.endswith(".framework"):
            frameworks.append(os.path.join(root, name))
    for name in files:
        path = os.path.join(root, name)
        if not is_macho(path) or is_framework_main_binary(path):
            continue
        # The bundle executable is sealed when the .app itself is signed.
        if os.path.dirname(path) == main_dir and os.path.basename(path).startswith("Avidemux"):
            continue
        machos.append(path)

# Presets, tinyPy scripts, and shaders live inside the bundle and codesign
# treats them as nested code. Sign every one of them before the app.
extra_roots = [
    os.path.join(app, "Contents", "MacOS", "ADM_plugins6"),
]
extra = []
for root in extra_roots:
    if not os.path.isdir(root):
        continue
    for dirpath, dirnames, filenames in os.walk(root):
        for name in filenames:
            path = os.path.join(dirpath, name)
            if os.path.islink(path) or is_macho(path):
                continue
            if name.endswith((".json", ".py", ".shader")):
                extra.append(path)

machos.sort(key=lambda p: p.count(os.sep), reverse=True)
frameworks.sort(key=lambda p: p.count(os.sep), reverse=True)
extra.sort(key=lambda p: p.count(os.sep), reverse=True)

for path in machos + extra:
    sign(path)
for path in frameworks:
    sign(path)


def sign_bundle(bundle):
    """Sign bundle, sealing any nested item codesign reports as unsigned."""
    cmd = ["/usr/bin/codesign", "--force", "--sign", "-", "--timestamp=none", bundle]
    for _ in range(300):
        proc = subprocess.run(cmd, capture_output=True, text=True)
        err = (proc.stderr or "") + (proc.stdout or "")
        if proc.returncode == 0:
            if err.strip():
                print(err, end="" if err.endswith("\n") else "\n")
            return
        print(err, end="" if err.endswith("\n") else "\n", file=sys.stderr)
        marker = "In subcomponent: "
        sub = ""
        for line in err.splitlines():
            if marker in line:
                sub = line.split(marker, 1)[1].strip()
        if not sub or not os.path.exists(sub):
            raise SystemExit(proc.returncode)
        sign(sub)
    raise SystemExit("too many unsigned nested items while signing %s" % bundle)


sign_bundle(app)

verify = ["/usr/bin/codesign", "--verify", "--deep", "--strict", "--verbose=2", app]
proc = subprocess.run(verify, capture_output=True, text=True)
out = (proc.stderr or "") + (proc.stdout or "")
if out.strip():
    print(out, end="" if out.endswith("\n") else "\n")
if proc.returncode != 0:
    print("Strict verify failed after inside-out signing; retrying with --deep", file=sys.stderr)
    subprocess.check_call(
        ["/usr/bin/codesign", "--force", "--deep", "--sign", "-", "--timestamp=none", app]
    )
    subprocess.check_call(verify)
PY

echo "** Ad-hoc signing completed. **"
